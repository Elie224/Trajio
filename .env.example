# ---------------------------------------------------------------------------
# Trajio - exemple de variables d'environnement.
# Copiez ce fichier vers .env (qui est ignore par Git) :
#   Copy-Item .env.example .env
# Aucun secret reel ne doit se trouver dans ce fichier.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=development
DEBUG=false

# --- API -------------------------------------------------------------------
API_PORT=8000

# Generer une vraie cle avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Obligatoire (compose refuse de demarrer sans). Hors developpement, l'API refuse
# toute cle de moins de 32 caracteres ou connue.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Liste separee par des virgules, sans espace obligatoire.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Hors developpement : liste obligatoire, sans joker.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api
# Jamais de jeton de reset dans la reponse HTTP. Laissez false.
EXPOSE_DEV_RESET_TOKEN=false
# Redis (compose). En local pytest, memory:// reste acceptable.
RATE_LIMIT_STORAGE_URI=memory://

PUBLIC_WEB_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Trajio <noreply@localhost>

# --- Base de donnees -------------------------------------------------------
POSTGRES_USER=trajio
# Obligatoire. Generer avec la meme commande que SECRET_KEY.
# Hors developpement, les valeurs par defaut (trajio, postgres...) sont refusees.
POSTGRES_PASSWORD=
POSTGRES_DB=trajio
POSTGRES_PORT=5432
# Laisser vide pour que l'API derive l'URL a partir des variables ci-dessus.
DATABASE_URL=
SQL_ECHO=false

# --- Frontend --------------------------------------------------------------
WEB_PORT=3000
# Doit etre joignable depuis le navigateur, pas seulement depuis le conteneur.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Geospatial (valeurs par defaut, surchargeables) -----------------------
DEFAULT_SEARCH_RADIUS_M=5000
MAX_SEARCH_RADIUS_M=20000
MAX_DETOUR_RATIO=0.30
MAX_DETOUR_MINUTES=20
